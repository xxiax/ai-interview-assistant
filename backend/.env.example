# ASR 引擎：默认 FunASR；可选 llm 或 groq
AI_ASR_ENGINE=funasr

# FunASR WebSocket：本地 ssh -N -L 隧道或同机服务
AI_FUNASR_URL=ws://127.0.0.1:10096/ws
# 默认复用 session + source 长连接；仅排障时设为 false 回退逐片连接
AI_FUNASR_STREAM=true
AI_LLM_SESSION_MAX_CONCURRENCY=3
AI_LLM_MAX_CONCURRENCY=4
# FunASR 引擎启用时必填；不得写入源码
AI_FUNASR_TOKEN=

# Groq Whisper API（仅启用 Groq ASR 路径时需要）
GROQ_API_KEY=

# 服务访问令牌（至少 32 个字符；REST 使用 Bearer Token，WebSocket 首条消息认证）
AI_AUTH_TOKEN=

# Fernet 密钥，用于加密数据库中的第三方 API Key
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CONFIG_ENCRYPTION_KEY=

# SQLite 数据库路径（缺省 interview.db）
AI_DB_PATH=interview.db

# 允许访问 API/WebSocket 的浏览器 Origin，逗号分隔
AI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 可选 Host 白名单，部署到公网时建议设置域名和反向代理内部 Host
AI_ALLOWED_HOSTS=

# 生产环境建议由反向代理终止 TLS；应用直连公网时设为 true
AI_REQUIRE_HTTPS=false

# 是否开放 /docs、/redoc 和 /openapi.json（默认 false，本地调试设 true）
AI_DOCS_ENABLED=false

# REST 与实时处理限制
AI_REST_RATE_LIMIT_PER_MINUTE=300
# 解码后最大 2 MiB，Base64 JSON 约 2.7 MiB
AI_MAX_AUDIO_CHUNK_BYTES=2097152
AI_MAX_AUDIO_DURATION_MS=10000
AI_AUDIO_DURATION_TOLERANCE_MS=750
AI_AUDIO_QUEUE_SIZE=8
AI_ANSWER_QUEUE_SIZE=8
AI_AUDIO_REORDER_WAIT_SECONDS=5
AI_FUNASR_FINAL_TIMEOUT_SECONDS=5
AI_FINAL_ANSWER_FLUSH_TIMEOUT_SECONDS=10

# 付费调用全局并发与持久化预算（按服务 Token 和供应商凭据双层计数）
AI_PAID_CALL_QUEUE_TIMEOUT_SECONDS=1
AI_SEARCH_MAX_CONCURRENCY=2
AI_ASR_MAX_CONCURRENCY=2
AI_LLM_TOKENS_PER_MINUTE=60000
AI_LLM_TOKENS_PER_HOUR=300000
AI_LLM_TOKENS_PER_DAY=1000000
AI_SEARCH_REQUESTS_PER_MINUTE=30
AI_SEARCH_REQUESTS_PER_HOUR=300
AI_SEARCH_REQUESTS_PER_DAY=2000
AI_ASR_SECONDS_PER_MINUTE=300
AI_ASR_SECONDS_PER_HOUR=3600
AI_ASR_SECONDS_PER_DAY=14400
AI_LLM_ANSWER_MAX_COMPLETION_TOKENS=512
AI_LLM_REVIEW_MAX_COMPLETION_TOKENS=2048

# 生产镜像已安装 ffprobe；本地自定义路径时设置该变量
AI_FFPROBE_PATH=ffprobe

# 仅本地开发调试使用；生产环境不要开启
AI_ALLOW_INSECURE_HTTP=false
AI_ALLOW_PRIVATE_LLM_HOSTS=false

# ASR 语言；设为 auto 时不向 Groq 固定语言
ASR_LANGUAGE=zh
