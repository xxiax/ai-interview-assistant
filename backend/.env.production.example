# Public DNS name. Point its A/AAAA records to this server before starting Caddy.
AI_PUBLIC_HOST=api.example.com
AI_ALLOWED_ORIGINS=https://app.example.com
AI_ASR_ENGINE=funasr
# 后端直接运行在宿主机时使用 127.0.0.1；Compose 容器访问宿主机隧道时改用
# ws://host.docker.internal:10096/ws（compose 已配置 host-gateway）。
AI_FUNASR_URL=ws://127.0.0.1:10096/ws
AI_FUNASR_STREAM=true
# 开放式 utterance：一个语音段只发一次 start/stop，中间分片只推裸 PCM。
# 推流后收取累计 partial 的空闲窗口与总上限（秒），允许 0.05-5 / 0.2-15。
AI_FUNASR_PARTIAL_IDLE_SECONDS=0.6
AI_FUNASR_PARTIAL_MAX_WAIT_SECONDS=3
AI_LLM_SESSION_MAX_CONCURRENCY=3
AI_LLM_MAX_CONCURRENCY=4
# 问题线程宽限期（秒），允许 0.5-30。累计 partial 按几何倍率节流触发
# 互不取消的 LLM revision，容量评估需按每问题多次调用计算。
AI_QUESTION_THREAD_GRACE_SECONDS=6
# revision 几何节流倍率（允许 1.0-5.0）：纯追加的累计 partial 要长到上一版的这个
# 倍数、或追加部分带句末标点才开新 revision；调大可压低调用次数。
AI_QUESTION_REVISION_GROWTH_RATIO=1.5

# Inject these values from the deployment platform's secret manager.
AI_AUTH_TOKEN=
AI_CONFIG_ENCRYPTION_KEY=
# FunASR 引擎启用时必填
AI_FUNASR_TOKEN=
GROQ_API_KEY=

# Optional outbound proxy (http/https/socks5/socks5h) for ASR/WebSocket egress.
# The container cannot read the host system proxy, so set it here when needed.
AI_OUTBOUND_PROXY=

# Interactive docs (/docs, /redoc, /openapi.json). Default off; enable only for debugging.
AI_DOCS_ENABLED=false

# Optional finite paid-service budgets. Defaults match compose.prod.yml.
AI_LLM_TOKENS_PER_MINUTE=60000
AI_LLM_TOKENS_PER_HOUR=300000
AI_LLM_TOKENS_PER_DAY=1000000
AI_SEARCH_REQUESTS_PER_MINUTE=30
AI_SEARCH_REQUESTS_PER_HOUR=300
AI_SEARCH_REQUESTS_PER_DAY=2000
AI_ASR_SECONDS_PER_MINUTE=300
AI_ASR_SECONDS_PER_HOUR=3600
AI_ASR_SECONDS_PER_DAY=14400
